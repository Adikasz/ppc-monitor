# ============================================================
# PPC AI Kampánymonitor — Környezeti változók
# ============================================================
# Másold ezt a fájlt ".env" néven, és töltsd ki az értékeket.
# A .env fájlt SOHA ne committold GitHub-ra (a .gitignore kizárja).

# ---- Supabase ----
# Project Settings → API oldalról
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...        # service_role secret kulcs (backend használja)

# ---- Discord ----
# Discord Developer Portal → Bot → Token
DISCORD_BOT_TOKEN=
# A szerver (guild) ID-ja, ahol a bot fut — fejlesztésnél a sajátunk
DISCORD_GUILD_ID=
# Az admin/config csatorna ID-ja, ahol a parancsokat kezeljük
DISCORD_ADMIN_CHANNEL_ID=

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=
# Melyik modellt használja az anomália-szövegezéshez
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ---- Meta Ads API ----
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
# Hosszú élettartamú system user token ajánlott

# ---- Google Ads API ----
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=    # MCC (manager) fiók ID kötőjelek nélkül

# ---- ClickUp ----
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
# A lista ID, ahova a CRITICAL taskok kerülnek (később bővíthető ügyfelenkénti routinggal)
CLICKUP_DEFAULT_LIST_ID=

# ---- Általános beállítások ----
# Időzóna a csendes idő / összefoglalók számításához
TIMEZONE=Europe/Budapest
# Csendes idő kezdete és vége (24h formátum)
QUIET_HOURS_START=18
QUIET_HOURS_END=9
# Naplózási szint: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
